{
  "name": "secrets-plz",
  "version": "0.0.1",
  "description": "An approval-based secrets loader for local development",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "secrets-plz": "./dist/run.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm test && pnpm build",
    "explore": "tsx src/backends/noxkey/dev/explore.ts",
    "probe": "tsx src/backends/noxkey/dev/probe.ts",
    "secrets-plz": "tsx src/run.ts",
    "test": "tsx --test src/mapping.test.ts src/backends/noxkey/handoff-parse.test.ts src/backends/noxkey/response.test.ts src/backends/noxkey/paths.test.ts src/run.test.ts"
  },
  "keywords": [
    "secrets-plz",
    "secrets",
    "mcp",
    "dotenv",
    "environment"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jlfwong/secrets-plz.git"
  },
  "homepage": "https://github.com/jlfwong/secrets-plz#readme",
  "bugs": {
    "url": "https://github.com/jlfwong/secrets-plz/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0"
  },
  "devDependencies": {
    "@types/node": "20.17.31",
    "tsx": "4.19.3",
    "typescript": "5.8.2"
  }
}
